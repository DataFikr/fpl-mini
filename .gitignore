node_modules

# Next.js build output
.next/
out/

# Keep environment variables out of version control
.env
.env.local
.env.production.local
.env.development.local

# API keys and secrets
*API_Key.txt
openAI_API_Key.txt
*.key
*.pem

# Generated files
/generated/prisma

# Cache directories
.fpl_cache/
scripts/fpl-predictor/.cache/
scripts/fpl-predictor/out/

# Remotion social-video renders (video/ workspace). The compositions are
# source and ARE tracked; the MP4/PNG output is regenerated by `npm run
# render:*` and must never be committed.
video/out/
video/.remotion/
# Generated audio beds (Higgsfield). Regenerable from the scripts in the
# publishing checklist, and too large to be worth tracking.
video/public/*.mp3
video/public/*.wav
video/public/*.m4a

# Python files (development scripts)
*.py

# Development documentation and notes
notes.txt

# Temporary files
nul
*.tmp
Thumbs.db

# Tableau embed code
bump_chart_tableau_embed_code.txt

# Theme files
fpl-theme.css

# Note: Images (png, jpg) are now INCLUDED in git for deployment
# If you have local dev images you don't want to commit,
# add them specifically (e.g., /dev-images/*.png)

# Captured B-roll for the video pipeline (regenerable via playwright.capture.config.ts)
video/public/*.webm
video/public/*.png
tests/capture/out/

# Trimmed clips from the screen captures in C:\Users\Family\Videos\Captures\.
# Re-derivable with the ffmpeg commands in video/README.md, and they hold
# unredacted frames of a real private mini-league — FR-05 patches the league
# name at render time, so the raw clip should not go into git history.
video/public/*.mp4

# Playwright run artifacts (screenshots, traces, videos) — regenerated on every run
tests/test-results/
tests/reports/
