# Database Configuration
DATABASE_URL="postgresql://username:password@localhost:5432/fpl_league_hub"

# Redis Configuration (optional - will use memory cache if not provided)
REDIS_URL="redis://localhost:6379"

# FPL API Configuration
FPL_API_BASE_URL="https://fantasy.premierleague.com/api"

# --- Demo season (product video / offline showcase) ---------------------------
# The live FPL API only serves the current season. To demo/record the app with a
# full, populated season (rank progression, headlines, predictions) before
# 2026/27 GW1, set FPL_DEMO_SEASON=2025-26. The app then serves the real 2025/26
# snapshots in scripts/fpl-predictor/.cache (bootstrap/fixtures/live) plus a
# synthesized 12-manager demo league, instead of the network.
# LEAVE UNSET IN PRODUCTION — flip off once 2026/27 GW1 data is live.
# FPL_DEMO_SEASON="2025-26"
# FPL_DEMO_GW="20"           # simulated "current" gameweek (2..38, default 20)
# FPL_SEASON="2025-26"       # tag predictor rows to match the demo season
# NEXT_PUBLIC_DEMO_PREMIUM="1"  # unlock premium UI (captain picks/transfers) for the promo video — OFF in production

# Next.js Configuration
NODE_ENV="production"

# Optional: Database connection pool settings
DATABASE_CONNECTION_LIMIT=5
DATABASE_TIMEOUT=20000

# Email Configuration (Resend)
# 1. Create an API key at https://resend.com/api-keys
# 2. FROM_EMAIL MUST use a domain you have VERIFIED in Resend (Domains tab).
#    Sending from an unverified domain is the #1 cause of subscribe emails
#    silently failing / landing the app in "demo mode".
RESEND_API_KEY="your_resend_api_key_here"
FROM_EMAIL="info@fplranker.com"

# Public base URL used in email links and by cron jobs to call internal APIs.
# In production set this to your deployed origin (e.g. https://fplranker.com).
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# Cron authentication. Set this in Vercel project env vars; Vercel Cron then
# automatically sends `Authorization: Bearer ${CRON_SECRET}` with each run.
# Required for /api/cron/thursday-reminder and /api/cron/weekly-summary.
CRON_SECRET="generate_a_long_random_string"

# Admin authentication (interim, until session-based admin auth ships).
# Gates PII / email-send routes: /api/admin/emails, /api/newsletter/subscriptions,
# /api/newsletter/send-bulk, /api/emails/summary, /api/test-email, and the
# /admin/emails dashboard. Sent as `x-admin-key` header or `?key=`.
# If unset, the guard falls back to CRON_SECRET; if neither is set, access is denied.
ADMIN_KEY="generate_a_different_long_random_string"

# Newsletter double opt-in confirm-link signing (I5). Falls back to CRON_SECRET/ADMIN_KEY.
# NEWSLETTER_SECRET="generate_a_long_random_string"

# Google Analytics 4 (GA4) Configuration
# Get your Measurement ID from Google Analytics (format: G-XXXXXXXXXX)
# https://analytics.google.com/
NEXT_PUBLIC_GA_MEASUREMENT_ID="G-XXXXXXXXXX"

# Predictor (workstream C). Season key for stored predictions; bump when the
# FPL API rolls to a new season (e.g. "2027-28").
FPL_SEASON="2026-27"

# Payments — Lemon Squeezy merchant-of-record (workstream B).
# Create products (Season Pass one-off, Annual subscription), then paste each
# variant's hosted "buy link" here. The webhook secret is set on the LS webhook.
LS_CHECKOUT_SEASON_URL="https://YOURSTORE.lemonsqueezy.com/buy/SEASON_VARIANT_ID"
LS_CHECKOUT_ANNUAL_URL="https://YOURSTORE.lemonsqueezy.com/buy/ANNUAL_VARIANT_ID"
LEMONSQUEEZY_WEBHOOK_SECRET="set_on_the_lemonsqueezy_webhook"